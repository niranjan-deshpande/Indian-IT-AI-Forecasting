# Downloaded source documents (filings, transcripts, PDFs): 2.3 GB, third-party material.
# Every source URL is recorded in the data and audit files.
data/sources/

.claude/
__pycache__/
*.pyc
.DS_Store

# Raw downloads behind the round-3/round-4 measurements (official files, filings, transcripts; >1 GB).
# Each FINDINGS.md records the source URLs; scripts re-download into raw/.
*/explore/**/raw/

# Output-side downloads for the health-check contradiction checks.
*/explore/**/raw_output/

# Local secrets (API keys)
.env

# Delegable-share raw downloads (benchmark data, O*NET/Eloundou); each SOURCE.md / data README records the URLs.
delegable_share/**/raw/
